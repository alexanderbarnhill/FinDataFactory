{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Encounters",
						"type": "DatasetReference"
					},
					"name": "Encounters"
				},
				{
					"dataset": {
						"referenceName": "EncounterAnimals",
						"type": "DatasetReference"
					},
					"name": "EncounterAnimals"
				},
				{
					"dataset": {
						"referenceName": "Animals",
						"type": "DatasetReference"
					},
					"name": "Animals"
				},
				{
					"dataset": {
						"referenceName": "Locations",
						"type": "DatasetReference"
					},
					"name": "Locations"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "EncounterData",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "join2"
				},
				{
					"name": "join3"
				},
				{
					"name": "join4"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Id as string,",
				"          Name as string,",
				"          Description as string,",
				"          DateTime as timestamp,",
				"          LocationId as string,",
				"          UserId as string,",
				"          InsertDateTime as timestamp,",
				"          PopulationId as string,",
				"          PredationEvent as boolean,",
				"          Complete as boolean,",
				"          LicenseId as string,",
				"          MarkedForDeletion as boolean,",
				"          Visible as boolean,",
				"          CompleteStatus as string,",
				"          InternalNotes as string,",
				"          AnalystId as string,",
				"          ArchivedBy as string,",
				"          ArchivedOn as timestamp,",
				"          MarkedForArchival as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Encounters",
				"source(output(",
				"          Id as string,",
				"          EncounterId as string,",
				"          AnimalId as string,",
				"          InsertDateTime as timestamp,",
				"          CoOccurrenceSet as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> EncounterAnimals",
				"source(output(",
				"          Id as string,",
				"          Identifier as string,",
				"          InsertDateTime as timestamp,",
				"          PopulationId as string,",
				"          DateOfBirth as timestamp,",
				"          Nickname as string,",
				"          Sex as string,",
				"          Notes as string,",
				"          DateOfDeath as timestamp,",
				"          HasProfile as boolean,",
				"          AlternateIds as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Animals",
				"source(output(",
				"          Id as string,",
				"          Name as string,",
				"          Latitude as float,",
				"          Longitude as float,",
				"          InsertDateTime as timestamp,",
				"          PopulationId as string,",
				"          Nominal as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Locations",
				"EncounterAnimals, Animals join(AnimalId == Animals@Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"Encounters, join1 join(Encounters@Id == EncounterId,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"Locations, Encounters join(Locations@Id == LocationId,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join3, join1 join(Encounters@Id == EncounterId,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join4",
				"join4 select(mapColumn(",
				"          Name = Locations@Name,",
				"          Latitude,",
				"          Longitude,",
				"          Id = Encounters@Id,",
				"          DateTime,",
				"          Identifier",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}